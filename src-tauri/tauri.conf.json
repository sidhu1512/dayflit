{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayflit",
  "version": "1.0.0",
  "identifier": "app.dayflit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis/hooks.nsh",
        "startMenuFolder": "Dayflit"
      }
    },
    "shortDescription": "Dayflit \u2014 floating desktop productivity companion",
    "longDescription": "Tasks, notes, focus sessions, habits, calendar and clipboard capture in a floating Windows companion.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNjYzMjA4M0Q3Qzg5NjgKUldSb2lYdzlDREptZ0ZPWDlFU21NOWJ2cnVUTHVZU2hNWGkvV1VuQjk4MHBjUk5yeEx4bytzYmUK",
      "endpoints": [
        "https://github.com/sidhu1512/dayflit/releases/latest/download/latest.json",
        "https://dayflit.example.com/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}