{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DayFlit",
  "version": "1.0.0",
  "identifier": "app.dayflit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob: https:; media-src 'self' asset: https://asset.localhost http://asset.localhost data: blob:; font-src 'self' data: https: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https:; frame-src 'self' https: http:; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/Dayflit/**",
          "$CONFIG/DayFlit/**",
          "$CONFIG/dayflit/**",
          "$APPDATA/Dayflit/**",
          "$APPDATA/DayFlit/**",
          "$APPDATA/dayflit/**",
          "$APPCONFIG/Dayflit/**",
          "$APPCONFIG/DayFlit/**",
          "$APPCONFIG/dayflit/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis/hooks.nsh",
        "startMenuFolder": "DayFlit"
      }
    },
    "shortDescription": "DayFlit — floating desktop productivity companion",
    "longDescription": "Tasks, notes, focus sessions, habits, calendar and clipboard capture in a floating Windows companion.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNjYzMjA4M0Q3Qzg5NjgKUldSb2lYdzlDREptZ0ZPWDlFU21NOWJ2cnVUTHVZU2hNWGkvV1VuQjk4MHBjUk5yeEx4bytzYmUK",
      "endpoints": [
        "https://github.com/sidhu1512/dayflit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}